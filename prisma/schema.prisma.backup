generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model accounts {
  id           Int            @id @default(autoincrement())
  full_name    String         @db.VarChar(100)
  phone_number String         @db.VarChar(50)
  birth_date   DateTime?      @db.Date
  username     String         @unique(map: "username") @db.VarChar(50)
  password     String         @db.VarChar(255)
  email        String         @unique(map: "email") @db.VarChar(100)
  role_id      Int?           @default(2)
  is_deleted   Boolean?       @default(false)
  is_verified  Boolean?       @default(false)
  created_at   DateTime?      @default(now()) @db.DateTime(0)
  updated_at   DateTime?      @default(now()) @updatedAt @db.DateTime(0)
  roles        roles?         @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings     bookings[]
  posts        posts[]
  reviews      reviews[]
  transactions transactions[]
  wishlist     wishlist[]

  @@index([role_id])
}

model bookings {
  id           Int            @id @default(autoincrement())
  customer_id  Int?
  tour_id      Int
  account_id   Int
  start_date   DateTime       @db.DateTime(0)
  end_date     DateTime       @db.DateTime(0)
  total_amount BigInt
  paid_amount  BigInt?        @default(0)
  status       String?        @default("pending") @db.VarChar(50)
  is_confirmed Boolean?       @default(false)
  is_deleted   Boolean?       @default(false)
  created_at   DateTime?      @default(now()) @db.DateTime(0)
  updated_at   DateTime?      @default(now()) @updatedAt @db.DateTime(0)
  customers    customers?     @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  tours        tours          @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts     accounts       @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions transactions[]

  @@index([customer_id])
  @@index([tour_id])
  @@index([account_id])
}

model customers {
  id            Int        @id @default(autoincrement())
  full_name     String     @db.VarChar(100)
  identity_card String?    @db.VarChar(50)
  is_male       Boolean?   @default(true)
  phone_number  String     @db.VarChar(50)
  address       String?    @db.VarChar(255)
  birth_date    DateTime?  @db.Date
  email         String?    @db.VarChar(100)
  province_id   Int?
  district_id   Int?
  ward_id       Int?
  is_deleted    Boolean?   @default(false)
  created_at    DateTime?  @default(now()) @db.DateTime(0)
  updated_at    DateTime?  @default(now()) @updatedAt @db.DateTime(0)
  bookings      bookings[]
  provinces     provinces? @relation(fields: [province_id], references: [id], onUpdate: NoAction)
  districts     districts? @relation(fields: [district_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wards         wards?     @relation(fields: [ward_id], references: [id], onUpdate: NoAction)

  @@index([province_id])
  @@index([district_id])
  @@index([ward_id])
}

model images {
  id         Int         @id @default(autoincrement())
  image_url  String      @db.VarChar(500)
  sort_order Int?        @default(0)
  is_deleted Boolean?    @default(false)
  created_at DateTime?   @default(now()) @db.DateTime(0)
  updated_at DateTime?   @default(now()) @updatedAt @db.DateTime(0)
  provinces  provinces[]
}

model promotions {
  id             Int            @id @default(autoincrement())
  code           String         @unique(map: "code") @db.VarChar(50)
  discount_type  String?        @db.VarChar(50)
  discount_value BigInt
  min_amount     BigInt?        @default(0)
  used_count     Int?           @default(0)
  start_date     DateTime       @db.DateTime(0)
  end_date       DateTime       @db.DateTime(0)
  is_active      Boolean?       @default(true)
  description    String?        @db.Text
  created_at     DateTime?      @default(now()) @db.DateTime(0)
  updated_at     DateTime?      @default(now()) @updatedAt @db.DateTime(0)
  transactions   transactions[]
}

model provinces {
  id            Int         @id @default(autoincrement())
  image_id      Int?
  province_code String      @unique(map: "province_code") @db.VarChar(50)
  province_name String      @db.VarChar(100)
  note          String?     @db.VarChar(100)
  is_deleted    Boolean?    @default(false)
  created_at    DateTime?   @default(now()) @db.DateTime(0)
  updated_at    DateTime?   @default(now()) @updatedAt @db.DateTime(0)
  customers     customers[]
  districts     districts[]
  images        images?     @relation(fields: [image_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tours         tours[]

  @@index([image_id])
}

model reviews {
  id          Int       @id @default(autoincrement())
  tour_id     Int
  account_id  Int
  rating      Int?
  comment     String?   @db.Text
  images      String?   @db.Text
  admin_reply String?   @db.Text
  is_deleted  Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  updated_at  DateTime? @default(now()) @updatedAt @db.DateTime(0)
  tours       tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts    accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tour_id])
  @@index([account_id])
}

model roles {
  id          Int        @id @default(autoincrement())
  role_name   String     @unique(map: "role_name") @db.VarChar(50)
  description String?    @db.VarChar(200)
  permissions String?    @db.Text
  created_at  DateTime?  @default(now()) @db.DateTime(0)
  updated_at  DateTime?  @default(now()) @updatedAt @db.DateTime(0)
  accounts    accounts[]
}

model tour_categories {
  id            Int       @id @default(autoincrement())
  category_name String    @db.VarChar(100)
  note          String?   @db.Text
  is_deleted    Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.DateTime(0)
  updated_at    DateTime? @default(now()) @updatedAt @db.DateTime(0)
  tours         tours[]
}

model tours {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(255)
  province_id     Int?
  location_name   String?          @db.VarChar(100)
  price           BigInt
  category_id     Int?
  description     String?          @db.Text
  sub_title       String?          @db.VarChar(255)
  max_slots       Int?             @default(20)
  start_date      DateTime?        @db.DateTime(0)
  end_date        DateTime?        @db.DateTime(0)
  duration_days   Int?             @default(1)
  is_active       Boolean?         @default(true)
  is_deleted      Boolean?         @default(false)
  created_at      DateTime?        @default(now()) @db.DateTime(0)
  updated_at      DateTime?        @default(now()) @updatedAt @db.DateTime(0)
  bookings        bookings[]
  reviews         reviews[]
  tour_images     tour_images[]
  tour_categories tour_categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  provinces       provinces?       @relation(fields: [province_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  wishlist        wishlist[]

  @@index([category_id])
  @@index([province_id])
}

model transactions {
  id               Int         @id @default(autoincrement())
  booking_id       Int
  account_id       Int
  promotion_id     Int?
  amount           BigInt?     @default(0)
  transaction_type String?     @default("payment") @db.VarChar(50)
  created_at       DateTime?   @default(now()) @db.DateTime(0)
  bookings         bookings    @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts         accounts    @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  promotions       promotions? @relation(fields: [promotion_id], references: [id], onUpdate: NoAction)

  @@index([booking_id])
  @@index([account_id])
  @@index([promotion_id])
}

model tour_images {
  id         Int       @id @default(autoincrement())
  tour_id    Int
  image_url  String    @db.VarChar(500)
  is_primary Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)
  tours      tours     @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tour_id])
}

model wishlist {
  id         Int       @id @default(autoincrement())
  account_id Int
  tour_id    Int
  created_at DateTime? @default(now()) @db.DateTime(0)
  accounts   accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tours      tours     @relation(fields: [tour_id], references: [id], onUpdate: NoAction)

  @@index([account_id])
  @@index([tour_id])
}

model districts {
  id            Int         @id @default(autoincrement())
  province_id   Int
  district_code String?     @db.VarChar(20)
  district_name String      @db.VarChar(100)
  is_deleted    Boolean?    @default(false)
  created_at    DateTime?   @default(now()) @db.DateTime(0)
  updated_at    DateTime?   @default(now()) @updatedAt @db.DateTime(0)
  customers     customers[]
  provinces     provinces   @relation(fields: [province_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wards         wards[]

  @@index([province_id])
}

model wards {
  id          Int       @id @default(autoincrement())
  district_id Int
  ward_code   String?   @db.VarChar(20)
  ward_name   String    @db.VarChar(100)
  is_deleted  Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)
  customers   customers[]
  districts   districts @relation(fields: [district_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([district_id])
}

model posts {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  excerpt    String?   @db.Text
  content    String    @db.Text
  category   String?   @db.VarChar(100)
  image_url  String?   @db.VarChar(500)
  views      Int?      @default(0)
  is_active  Boolean?  @default(true)
  account_id Int?
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @updatedAt @db.DateTime(0)
  accounts   accounts? @relation(fields: [account_id], references: [id], onUpdate: NoAction)

  @@index([account_id])
}